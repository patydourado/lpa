package exemplos;

public class ExMatriz {

	public static void main(String[] args) {

    //declaração e inicialização de uma matriz quadrada
		int matriz[][] = new int[3][3];

    //Preenchimento de uma matriz quadrada
		for (int i = 0; i < 3; i++) {
			for (int j = 0; j <3; j++) {
				matriz[i][j]=((i+j)*4)+12;
			}
		}
	}

}
